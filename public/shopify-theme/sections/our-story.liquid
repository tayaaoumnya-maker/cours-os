{% comment %}
  Section: Our Story
  Section "Notre histoire" avec visuel et texte
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <section class="fh-story" style="background:{{ section.settings.bg_color }}">
    <div class="fh-story-inner">
      <div class="fh-story-visual">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'fh-story-img' }}
        {% else %}
          <span class="fh-story-emoji">{{ section.settings.emoji }}</span>
        {% endif %}
      </div>
      <div class="fh-story-content">
        <div class="fh-section-overline" style="color:{{ section.settings.accent_color }}">{{ section.settings.overline }}</div>
        <h2 class="fh-story-title">
          {{ section.settings.title_line1 }}<br>
          {{ section.settings.title_line2_before }} <span style="color:{{ section.settings.accent_color }}">{{ section.settings.title_line2_accent }}</span>
        </h2>
        {% for block in section.blocks %}
          {% if block.type == 'paragraph' %}
            <p class="fh-story-p" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {% endif %}
        {% endfor %}
        {% if section.settings.link_text != blank %}
          <a href="{{ section.settings.link_url }}" class="fh-story-link">{{ section.settings.link_text }} &rarr;</a>
        {% endif %}
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .fh-story{padding:100px 48px;position:relative;overflow:hidden}
    #shopify-section-{{ section.id }} .fh-story::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 50%,rgba(13,27,42,0.03),transparent 60%)}
    #shopify-section-{{ section.id }} .fh-story-inner{max-width:1100px;margin:0 auto;display:flex;gap:64px;align-items:center;flex-wrap:wrap;position:relative;z-index:1}
    #shopify-section-{{ section.id }} .fh-story-visual{flex:1;min-width:300px;aspect-ratio:4/3;border-radius:20px;overflow:hidden;background:#fff;border:1px solid #e0e0dc;display:flex;align-items:center;justify-content:center;position:relative;box-shadow:0 4px 16px rgba(0,0,0,0.06)}
    #shopify-section-{{ section.id }} .fh-story-emoji{font-size:100px}
    #shopify-section-{{ section.id }} .fh-story-img{width:100%;height:100%;object-fit:cover}
    #shopify-section-{{ section.id }} .fh-story-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(13,27,42,0.05),transparent 60%);pointer-events:none}
    #shopify-section-{{ section.id }} .fh-story-content{flex:1;min-width:300px}
    #shopify-section-{{ section.id }} .fh-section-overline{font-size:11px;text-transform:uppercase;letter-spacing:4px;font-weight:700;margin-bottom:12px}
    #shopify-section-{{ section.id }} .fh-story-title{font-family:'Bebas Neue',Impact,sans-serif;font-size:52px;text-transform:uppercase;letter-spacing:2px;margin-bottom:24px;line-height:1.05;color:#0d1b2a}
    #shopify-section-{{ section.id }} .fh-story-p{font-size:16px;color:#444;line-height:1.8;margin-bottom:18px;font-weight:300;font-family:'Inter',sans-serif}
    #shopify-section-{{ section.id }} .fh-story-link{display:inline-flex;align-items:center;gap:8px;color:{{ section.settings.accent_color }};text-decoration:none;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:2px;transition:gap .3s;border-bottom:1px solid rgba(13,27,42,0.3);padding-bottom:4px}
    #shopify-section-{{ section.id }} .fh-story-link:hover{gap:14px;border-color:{{ section.settings.accent_color }}}
    @media(max-width:900px){
      #shopify-section-{{ section.id }} .fh-story{padding:64px 20px}
      #shopify-section-{{ section.id }} .fh-story-inner{flex-direction:column}
      #shopify-section-{{ section.id }} .fh-story-title{font-size:36px}
    }
  </style>
</div>

{% schema %}
{
  "name": "Notre histoire",
  "tag": "section",
  "class": "fh-our-story-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f5f5f3"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur accent",
      "default": "#d4a843"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Surtitre",
      "default": "Notre histoire"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Titre ligne 1",
      "default": "Nés entre"
    },
    {
      "type": "text",
      "id": "title_line2_before",
      "label": "Titre ligne 2 avant accent",
      "default": "deux"
    },
    {
      "type": "text",
      "id": "title_line2_accent",
      "label": "Titre ligne 2 accent",
      "default": "cultures"
    },
    {
      "type": "text",
      "id": "emoji",
      "label": "Emoji visuel",
      "default": "⚽🌍"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optionnel)"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Texte du lien",
      "default": "Lire toute notre histoire"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "URL du lien"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraphe",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte",
          "default": "On a grandi en vibrant pour deux équipes."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Notre histoire",
      "blocks": [
        { "type": "paragraph", "settings": { "text": "On a grandi en vibrant pour deux équipes. En criant devant la télé avec nos parents pour un match, puis en célébrant dans la rue avec nos potes pour l'autre." } },
        { "type": "paragraph", "settings": { "text": "Nation Varsity est né de cette double fierté. Chaque t-shirt raconte l'histoire d'un pays, d'une diaspora, d'une passion partagée." } }
      ]
    }
  ]
}
{% endschema %}
