{% comment %}
  Section: Hero World Cup
  Hero plein ecran avec countdown, light beams, particles et card stack
{% endcomment %}

<div id="shopify-section-{{ section.id }}">
  <section class="fh-hero">
    <div class="fh-hero-lights">
      <div class="fh-light-beam"></div><div class="fh-light-beam"></div><div class="fh-light-beam"></div><div class="fh-light-beam"></div><div class="fh-light-beam"></div>
    </div>
    <div class="fh-particles">
      <div class="fh-particle"></div><div class="fh-particle"></div><div class="fh-particle"></div><div class="fh-particle"></div><div class="fh-particle"></div><div class="fh-particle"></div>
    </div>
    <div class="fh-hero-inner">
      <div class="fh-hero-text">
        {% if section.settings.show_countdown %}
        <div class="fh-countdown" data-target="{{ section.settings.countdown_date }}">
          <div class="fh-cd-block"><span class="fh-cd-num" data-cd="days">--</span><span class="fh-cd-label">Jours</span></div>
          <div class="fh-cd-sep">:</div>
          <div class="fh-cd-block"><span class="fh-cd-num" data-cd="hours">--</span><span class="fh-cd-label">Heures</span></div>
          <div class="fh-cd-sep">:</div>
          <div class="fh-cd-block"><span class="fh-cd-num" data-cd="mins">--</span><span class="fh-cd-label">Min</span></div>
          <div class="fh-cd-sep">:</div>
          <div class="fh-cd-block"><span class="fh-cd-num" data-cd="secs">--</span><span class="fh-cd-label">Sec</span></div>
        </div>
        {% endif %}
        <h1 class="fh-hero-h1">
          <span class="fh-line1">{{ section.settings.line1 }}</span>
          <span class="fh-line2">{{ section.settings.line2 }}</span>
          <span class="fh-line3" style="color:{{ section.settings.accent_color }}">{{ section.settings.line3 }}</span>
        </h1>
        <p class="fh-hero-sub">{{ section.settings.subtitle }}</p>
        <div class="fh-hero-actions">
          {% if section.settings.cta_text != blank %}
            <a href="{{ section.settings.cta_link }}" class="fh-btn-fire">{{ section.settings.cta_text }} &rarr;</a>
          {% endif %}
          {% if section.settings.cta2_text != blank %}
            <a href="{{ section.settings.cta2_link }}" class="fh-btn-ghost">{{ section.settings.cta2_text }}</a>
          {% endif %}
        </div>
        <div class="fh-hero-trust">
          {% for block in section.blocks %}
            {% if block.type == 'trust_badge' %}
              <div class="fh-hero-trust-item" {{ block.shopify_attributes }}>
                <span class="fh-ic">&#10003;</span> {{ block.settings.text }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="fh-hero-visual">
        <div class="fh-hero-card-stack">
          {% for block in section.blocks %}
            {% if block.type == 'hero_card' %}
              <div class="fh-hero-card fh-hc-{{ forloop.index }}" style="background:{{ block.settings.gradient }}" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'eager', class: 'fh-card-img' }}
                {% else %}
                  <span class="fh-flag">{{ block.settings.flag_emoji }}</span>
                {% endif %}
                <div class="fh-hero-card-label">
                  <div class="fh-hc-name">{{ block.settings.country_name }}</div>
                  <div class="fh-hc-price">{{ block.settings.price }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .fh-hero{min-height:100vh;display:flex;align-items:center;position:relative;overflow:hidden;background:{{ section.settings.bg_color }} url('https://res.cloudinary.com/dkaldvbmm/image/upload/v1776697506/shopify/banner-smoke.png') center bottom/cover no-repeat !important}
    #shopify-section-{{ section.id }} .fh-hero-lights{position:absolute;inset:0;overflow:hidden;pointer-events:none}
    #shopify-section-{{ section.id }} .fh-light-beam{position:absolute;width:2px;height:120vh;background:linear-gradient(180deg,transparent,rgba(255,255,255,0.03),transparent);transform:rotate(-15deg);animation:fhBeam 8s ease-in-out infinite}
    #shopify-section-{{ section.id }} .fh-light-beam:nth-child(1){left:10%;animation-delay:0s}
    #shopify-section-{{ section.id }} .fh-light-beam:nth-child(2){left:30%;animation-delay:2s;width:3px}
    #shopify-section-{{ section.id }} .fh-light-beam:nth-child(3){left:55%;animation-delay:4s}
    #shopify-section-{{ section.id }} .fh-light-beam:nth-child(4){left:75%;animation-delay:1s;width:3px}
    #shopify-section-{{ section.id }} .fh-light-beam:nth-child(5){left:90%;animation-delay:3s}
    @keyframes fhBeam{0%,100%{opacity:.3;transform:rotate(-15deg)}50%{opacity:.8;transform:rotate(-12deg)}}
    #shopify-section-{{ section.id }} .fh-particles{position:absolute;inset:0;pointer-events:none}
    #shopify-section-{{ section.id }} .fh-particle{position:absolute;width:4px;height:4px;border-radius:50%;animation:fhFloat 6s ease-in-out infinite}
    #shopify-section-{{ section.id }} .fh-particle:nth-child(1){background:#0d1b2a;top:20%;left:15%;animation-delay:0s}
    #shopify-section-{{ section.id }} .fh-particle:nth-child(2){background:#d4a843;top:60%;left:80%;animation-delay:1.5s;width:3px;height:3px}
    #shopify-section-{{ section.id }} .fh-particle:nth-child(3){background:#fff;top:40%;left:45%;animation-delay:3s;width:2px;height:2px;opacity:.5}
    #shopify-section-{{ section.id }} .fh-particle:nth-child(4){background:#d4a843;top:75%;left:25%;animation-delay:4s;width:5px;height:5px}
    #shopify-section-{{ section.id }} .fh-particle:nth-child(5){background:#0d1b2a;top:30%;left:70%;animation-delay:2s;width:3px;height:3px}
    #shopify-section-{{ section.id }} .fh-particle:nth-child(6){background:#fff;top:85%;left:60%;animation-delay:5s;width:2px;height:2px;opacity:.4}
    @keyframes fhFloat{0%,100%{transform:translateY(0) scale(1);opacity:.6}50%{transform:translateY(-30px) scale(1.5);opacity:1}}
    #shopify-section-{{ section.id }} .fh-hero-inner{position:relative;z-index:2;width:100%;max-width:1400px;margin:0 auto;padding:100px 64px 80px;display:flex;align-items:center;gap:80px}
    #shopify-section-{{ section.id }} .fh-hero-text{flex:1.2}
    #shopify-section-{{ section.id }} .fh-countdown{display:flex;gap:16px;margin-bottom:32px}
    #shopify-section-{{ section.id }} .fh-cd-block{text-align:center}
    #shopify-section-{{ section.id }} .fh-cd-num{font-family:'Bebas Neue',Impact,sans-serif;font-size:48px;color:#fff;line-height:1;display:block;text-shadow:0 0 30px rgba(212,168,67,0.3)}
    #shopify-section-{{ section.id }} .fh-cd-label{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:{{ section.settings.accent_color }};font-weight:600;margin-top:4px}
    #shopify-section-{{ section.id }} .fh-cd-sep{font-family:'Bebas Neue',Impact,sans-serif;font-size:36px;color:rgba(255,255,255,0.15);padding-top:6px}
    #shopify-section-{{ section.id }} .fh-hero-h1{font-family:'Bebas Neue',Impact,sans-serif;font-size:96px;line-height:0.95;letter-spacing:2px;margin-bottom:20px;text-transform:uppercase}
    #shopify-section-{{ section.id }} .fh-line1{display:block;color:rgba(255,255,255,0.4);font-size:48px;letter-spacing:6px}
    #shopify-section-{{ section.id }} .fh-line2{display:block;color:#fff;text-shadow:0 0 60px rgba(13,27,42,0.3)}
    #shopify-section-{{ section.id }} .fh-line3{display:block;text-shadow:0 0 60px rgba(212,168,67,0.4)}
    #shopify-section-{{ section.id }} .fh-hero-sub{font-size:16px;color:rgba(255,255,255,0.85);line-height:1.7;margin-bottom:36px;max-width:440px;font-weight:400;font-family:'Inter',sans-serif;text-shadow:0 1px 4px rgba(0,0,0,0.6)}
    #shopify-section-{{ section.id }} .fh-hero-actions{display:flex;gap:16px;align-items:center;margin-bottom:28px}
    #shopify-section-{{ section.id }} .fh-btn-fire{display:inline-flex;align-items:center;gap:10px;background:linear-gradient(135deg,#0d1b2a,#162d4a);color:#fff;padding:18px 36px;border-radius:6px;font-size:13px;font-weight:800;text-decoration:none;text-transform:uppercase;letter-spacing:2px;transition:all .3s;box-shadow:0 8px 32px rgba(13,27,42,0.3)}
    #shopify-section-{{ section.id }} .fh-btn-fire:hover{transform:translateY(-2px);box-shadow:0 16px 48px rgba(13,27,42,0.45)}
    #shopify-section-{{ section.id }} .fh-btn-ghost{color:rgba(255,255,255,0.85);font-size:13px;font-weight:600;text-decoration:none;letter-spacing:1px;text-transform:uppercase;transition:color .3s;border-bottom:1px solid rgba(255,255,255,0.4);padding-bottom:2px;text-shadow:0 1px 4px rgba(0,0,0,0.6)}
    #shopify-section-{{ section.id }} .fh-btn-ghost:hover{color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }}}
    #shopify-section-{{ section.id }} .fh-hero-trust{display:flex;gap:24px;flex-wrap:wrap}
    #shopify-section-{{ section.id }} .fh-hero-trust-item{display:flex;align-items:center;gap:6px;font-size:11px;color:rgba(255,255,255,0.75);text-transform:uppercase;letter-spacing:1px;font-family:'Inter',sans-serif;text-shadow:0 1px 3px rgba(0,0,0,0.5)}
    #shopify-section-{{ section.id }} .fh-ic{color:{{ section.settings.accent_color }};font-size:14px}
    #shopify-section-{{ section.id }} .fh-hero-visual{flex:1;display:flex;justify-content:center;position:relative}
    #shopify-section-{{ section.id }} .fh-hero-card-stack{position:relative;width:340px;height:480px}
    #shopify-section-{{ section.id }} .fh-hero-card{position:absolute;width:300px;height:440px;border-radius:20px;overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:0 30px 80px rgba(0,0,0,0.5);transition:all .6s cubic-bezier(.4,0,.2,1)}
    #shopify-section-{{ section.id }} .fh-hero-card .fh-flag{font-size:120px;filter:drop-shadow(0 10px 30px rgba(0,0,0,0.4))}
    #shopify-section-{{ section.id }} .fh-hero-card .fh-card-img{width:100%;height:100%;object-fit:contain;object-position:center 40%;padding:20px 16px 60px}
    #shopify-section-{{ section.id }} .fh-hero-card::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,0.6) 100%)}
    #shopify-section-{{ section.id }} .fh-hero-card-label{position:absolute;bottom:20px;left:20px;z-index:2}
    #shopify-section-{{ section.id }} .fh-hc-name{font-family:'Bebas Neue',Impact,sans-serif;font-size:24px;color:#fff;letter-spacing:1px}
    #shopify-section-{{ section.id }} .fh-hc-price{font-size:14px;color:#f0d78c;font-weight:600}
    #shopify-section-{{ section.id }} .fh-hero-card.fh-card-front{top:0;left:0;z-index:3;transform:rotate(-2deg) scale(1);opacity:1}
    #shopify-section-{{ section.id }} .fh-hero-card.fh-card-mid{top:20px;left:40px;z-index:2;transform:rotate(3deg) scale(.95);opacity:.7}
    #shopify-section-{{ section.id }} .fh-hero-card.fh-card-back{top:40px;left:80px;z-index:1;transform:rotate(7deg) scale(.9);opacity:.4}
    #shopify-section-{{ section.id }} .fh-hero-card.fh-card-exit{top:-20px;left:-40px;z-index:0;transform:rotate(-10deg) scale(.85) translateY(-30px);opacity:0}
    #shopify-section-{{ section.id }} .fh-hero-card-stack:hover .fh-hero-card.fh-card-front{transform:rotate(0deg) translateX(-20px) scale(1)}
    #shopify-section-{{ section.id }} .fh-hero-card-stack:hover .fh-hero-card.fh-card-mid{transform:rotate(0deg) translateX(0) scale(.95);opacity:1}
    #shopify-section-{{ section.id }} .fh-hero-card-stack:hover .fh-hero-card.fh-card-back{transform:rotate(0deg) translateX(20px) scale(.9);opacity:.8}
    @media(max-width:900px){
      #shopify-section-{{ section.id }} .fh-hero-inner{flex-direction:column;padding:60px 24px;gap:48px;text-align:center}
      #shopify-section-{{ section.id }} .fh-hero-h1{font-size:56px}
      #shopify-section-{{ section.id }} .fh-line1{font-size:32px}
      #shopify-section-{{ section.id }} .fh-hero-sub{margin:0 auto 36px}
      #shopify-section-{{ section.id }} .fh-hero-actions{justify-content:center}
      #shopify-section-{{ section.id }} .fh-hero-trust{justify-content:center}
      #shopify-section-{{ section.id }} .fh-hero-card-stack{width:260px;height:380px}
      #shopify-section-{{ section.id }} .fh-hero-card{width:240px;height:360px}
      #shopify-section-{{ section.id }} .fh-countdown{justify-content:center}
    }
    @media(max-width:500px){
      #shopify-section-{{ section.id }} .fh-hero-h1{font-size:44px}
      #shopify-section-{{ section.id }} .fh-cd-num{font-size:36px}
    }
  </style>

  <script>
    (function(){
      var section = document.getElementById('shopify-section-{{ section.id }}');

      /* Fix: force background image over inline style from theme editor */
      var hero = section.querySelector('.fh-hero');
      if(hero){
        hero.style.background = '{{ section.settings.bg_color }} url(https://res.cloudinary.com/dkaldvbmm/image/upload/v1776697506/shopify/banner-smoke.png) center bottom/cover no-repeat';
      }

      {% if section.settings.show_countdown %}
      var cd = section.querySelector('.fh-countdown');
      if(cd){
        var target = new Date(cd.dataset.target).getTime();
        function update(){
          var now = Date.now(), d = target - now;
          if(d < 0) return;
          cd.querySelector('[data-cd="days"]').textContent = String(Math.floor(d/86400000)).padStart(2,'0');
          cd.querySelector('[data-cd="hours"]').textContent = String(Math.floor((d%86400000)/3600000)).padStart(2,'0');
          cd.querySelector('[data-cd="mins"]').textContent = String(Math.floor((d%3600000)/60000)).padStart(2,'0');
          cd.querySelector('[data-cd="secs"]').textContent = String(Math.floor((d%60000)/1000)).padStart(2,'0');
        }
        update();
        setInterval(update, 1000);
      }
      {% endif %}

      /* Card stack auto-rotation */
      var stack = section.querySelector('.fh-hero-card-stack');
      if(!stack) return;
      var cards = Array.from(stack.querySelectorAll('.fh-hero-card'));
      if(cards.length < 2) return;
      var slots = ['fh-card-front','fh-card-mid','fh-card-back'];
      var order = [];
      for(var i = cards.length - 1; i >= 0; i--) order.push(i);
      function apply(){
        for(var i = 0; i < cards.length; i++){
          cards[order[i]].classList.remove('fh-card-front','fh-card-mid','fh-card-back','fh-card-exit');
          cards[order[i]].classList.add(i < slots.length ? slots[i] : 'fh-card-exit');
        }
      }
      apply();
      var paused = false;
      stack.addEventListener('mouseenter', function(){ paused = true; });
      stack.addEventListener('mouseleave', function(){ paused = false; });
      setInterval(function(){
        if(paused) return;
        order.push(order.shift());
        apply();
      }, 3000);
    })();
  </script>
</div>

{% schema %}
{
  "name": "Hero World Cup",
  "tag": "section",
  "class": "fh-hero-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#0d1b2a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur accent (or)",
      "default": "#d4a843"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Afficher le countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Date cible (ISO)",
      "default": "2026-06-11T00:00:00"
    },
    {
      "type": "text",
      "id": "line1",
      "label": "Ligne 1 (kicker)",
      "default": "Coupe du Monde 2026"
    },
    {
      "type": "text",
      "id": "line2",
      "label": "Ligne 2",
      "default": "Porte tes"
    },
    {
      "type": "text",
      "id": "line3",
      "label": "Ligne 3 (accent)",
      "default": "Origines"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "T-shirts fan premium pour la diaspora. Design exclusif, coton respirant, fabriqué en Europe. Sois prêt pour le coup d'envoi."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Bouton principal texte",
      "default": "Shopper la collection"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bouton principal lien"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Bouton secondaire texte",
      "default": "Notre histoire"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Bouton secondaire lien"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Badge confiance",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Remboursé 30j"
        }
      ]
    },
    {
      "type": "hero_card",
      "name": "Carte pays",
      "settings": [
        {
          "type": "text",
          "id": "flag_emoji",
          "label": "Emoji drapeau",
          "default": "🇲🇦"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image produit (optionnel)"
        },
        {
          "type": "text",
          "id": "gradient",
          "label": "Gradient CSS",
          "default": "linear-gradient(160deg,#c1272d,#7a1018)"
        },
        {
          "type": "text",
          "id": "country_name",
          "label": "Nom pays",
          "default": "Maroc"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Prix affiché",
          "default": "34,99 €"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero World Cup",
      "blocks": [
        { "type": "trust_badge", "settings": { "text": "Remboursé 30j" } },
        { "type": "trust_badge", "settings": { "text": "Made in Europe" } },
        { "type": "trust_badge", "settings": { "text": "3-5 jours" } },
        { "type": "hero_card", "settings": { "flag_emoji": "🇨🇮", "gradient": "linear-gradient(160deg,#FF8200,#cc6500)", "country_name": "Côte d'Ivoire", "price": "34,99 €" } },
        { "type": "hero_card", "settings": { "flag_emoji": "🇩🇿", "gradient": "linear-gradient(160deg,#006233,#003d1f)", "country_name": "Algérie", "price": "34,99 €" } },
        { "type": "hero_card", "settings": { "flag_emoji": "🇲🇦", "gradient": "linear-gradient(160deg,#c1272d,#7a1018)", "country_name": "Maroc", "price": "34,99 €" } }
      ]
    }
  ]
}
{% endschema %}
